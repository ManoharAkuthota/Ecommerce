# ==============================================================================
# MS Mobiles Backend — Production Environment Variables Template
# Copy to .env or supply via Docker / Kubernetes secret manager
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/mobile_store?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=YourSecurePasswordHere

# Security & JWT Token Signing Secret (Min 256-bit entropy HMAC-SHA256)
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
JWT_EXPIRATION=86400000

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://msmobiles.com,https://admin.msmobiles.com,http://localhost:5173

# Logging & Performance
SHOW_SQL=false
